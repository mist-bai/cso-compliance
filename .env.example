# 本地开发（复制为 .env）
# 无 Docker 时可用：DATABASE_URL=sqlite:///./cso.db
# DATABASE_URL=sqlite:///./cso.db

MYSQL_ROOT_PASSWORD=cso_root_pass
MYSQL_DATABASE=cso_compliance
MYSQL_USER=cso
MYSQL_PASSWORD=cso_pass
MYSQL_HOST=mysql
MYSQL_PORT=3306

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

BACKEND_PORT=8200
FRONTEND_PORT=3200
NEXT_PUBLIC_API_BASE=/api
